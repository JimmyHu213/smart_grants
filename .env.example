# ─── Supabase ───────────────────────────────────────────
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used server-side for admin operations (e.g. creating users)
# Found in Supabase project settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Database (Supabase Postgres) ──────────────────────
# Pooled connection (port 6543) — used by Prisma Client at runtime
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used by Prisma CLI for migrations
DIRECT_URL="postgresql://postgres.your-project:your-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# ─── AI (Sprint 3) ─────────────────────────────────────
# Anthropic API key for AI eligibility matching
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Grant Crawler ─────────────────────────────────────
# URL of the FastAPI crawler service (Railway deployment)
CRAWLER_SERVICE_URL=https://your-crawler.up.railway.app
# Shared API key for authenticating crawler requests
CRAWLER_API_KEY=your-crawler-api-key-here
